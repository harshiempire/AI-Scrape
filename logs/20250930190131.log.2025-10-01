\\\displaystyle\\\\rm r=\\\\frac{\\\\rm\\\\sum_{i}^{N}(X_{i}-\\\\overline{X})(Y_{i}-\\\\overline{Y%\\n})}{\\\\rm\\\\sqrt{\\\\sum_{i}^{N}(X_{i}-\\\\overline{X})^{2}\\\\sum_{i}^{N}(Y_{i}-\\\\overline{%\\nY})^{2}}}\\\\,,roman_r = divide start_ARG ∑ start_POSTSUBSCRIPT roman_i end_POSTSUBSCRIPT start_POSTSUPERSCRIPT roman_N end_POSTSUPERSCRIPT ( roman_X start_POSTSUBSCRIPT roman_i end_POSTSUBSCRIPT - over¯ start_ARG roman_X end_ARG ) ( roman_Y start_POSTSUBSCRIPT roman_i end_POSTSUBSCRIPT - over¯ start_ARG roman_Y end_ARG ) end_ARG start_ARG square-root start_ARG ∑ start_POSTSUBSCRIPT roman_i end_POSTSUBSCRIPT start_POSTSUPERSCRIPT roman_N end_POSTSUPERSCRIPT ( roman_X start_POSTSUBSCRIPT roman_i end_POSTSUBSCRIPT - over¯ start_ARG roman_X end_ARG ) start_POSTSUPERSCRIPT 2 end_POSTSUPERSCRIPT ∑ start_POSTSUBSCRIPT roman_i end_POSTSUBSCRIPT start_POSTSUPERSCRIPT roman_N end_POSTSUPERSCRIPT ( roman_Y start_POSTSUBSCRIPT roman_i end_POSTSUBSCRIPT - over¯ start_ARG roman_Y end_ARG ) start_POSTSUPERSCRIPT 2 end_POSTSUPERSCRIPT end_ARG end_ARG ,\",\n          \"\",\n          \"(1)\"\n        ],\n        \"rows\": []\n      },\n      {\n        \"headers\": [\n          \"\",\n          \"PSolar%=Averaged⁢SolarAveraged⁢Demand⋅100,subscriptPpercentSolar⋅AveragedSolarAveragedDemand100\\\\displaystyle\\\\rm P_{Solar\\\\%}=\\\\frac{\\\\rm Averaged\\\\;Solar}{\\\\rm Averaged\\\\;Demand}%\\n\\\\,\\\\cdot 100,roman_P start_POSTSUBSCRIPT roman_Solar % end_POSTSUBSCRIPT = divide start_ARG roman_Averaged roman_Solar end_ARG start_ARG roman_Averaged roman_Demand end_ARG ⋅ 100 ,\",\n          \"\",\n          \"(2)\"\n        ],\n        \"rows\": []\n      }\n    ]\n  },\n  \"quality_metrics\": {\n    \"readability_score\": 0.3579829642080287,\n    \"content_density\": 0.12822643096348035,\n    \"authority_indicators\": [\n      \"CITATIONS_PRESENT\",\n      \"INSTITUTIONAL_DOMAIN\"\n    ],\n    \"credibility_score\": 1\n  },\n  \"scrape_timestamp\": \"2025-09-30T19:07:25.139Z\",\n  \"s