\\u000f\\u00119,�G��' ��s䚘��\\u0016s����\\u0012bH \\u0015���FOIdpБ���κ�ZV���>o{��^k��\\u001c�)�h^#R&E�C�\\u0001��} � ޯ�Xa �\\\\\\\\M� �Q�Iq���ܥ .�bĝ�����S\\u001d�ۥƧK+�k�u\\u0019ǚ\\\\\\\\\\u0019߈\\u0018Oo\\u000e\\\\[���yo\\\\]��T��\\\\_\\u0007� n�{��.��\\u001e�����V�y����8\\\\[\\b�u$�tŁ(\\u0019\\u0013\\u0014�ؘCn��i���\\u0004\\u001ahG���R�ؽ&���O\\\\[����=VT�s0,\\\"!� �i%5\\u00035�A��9;�����a�#%zȎٱ���\\u0001�ⅎ�Eo��Ԯ!^݁�P\\\\]���3̉\\\\\\\\g�D�\\u000eNn�;� �)\\u001a�~���\\u000f��s�q%rIl\\u000f��� �\\u0016\\u0011��|M%�jG��\\u0011�QL�wvW\\u000ew\\u0001:�7%\\u0001\\\\]����AW7��\\\\[\\u001d o�� h�R�\\bڙ�7{Z���ؽJ\\\"��h��Vr-\\u0011@=iIB\\u0019\\u001f �4̶\\u001e^����s\\u0019�\\\\[\\u001b�ue\\u0006�,\\\\]��<2y&������\\u0006�\\u0006�n\\u0002�t�{�)+ �%��� �~ޮ��\\u0011~l�5\\\\]�Z�\\u0006\\u001e\\u001bj�\\u0013��¾7\\u0019�@v��>':3%'�P� +PJY�����0\\u0005���u#3܅�c\\u0003?���xv\\u0018FPn�������\\u000fwr�4^�+i'\\\\*,\\u0010�D��H\\u0018�\\u001a#�\\u000e/�\\u0013�\\u001c\\u001f�\\u0019h�:�I�g��s��Hdie,\\\\[y\\u0016�&\\u001d+\\u000ee<�\\\"\\u0002\\\\\\\\�\\\\\\\\�����\\u001e��w�up�.�\\u001d���\\u0013' �Rҳ�S\\u000e�.�?��X�#�i+�4�\\u0004� ����������\\u0011\\\\_Biq�X��@�����;5�l� �k�7sĿ�\\\\]�\\\\]��H��W֐�\\u0015\\u001d\\u0012��c\\\"\\u0002Kz5�\\u0017�LdJ��\\u001a\\\"?ａ��P��V �9?�\\\\_��8a\\u001b���'Tnx��\\u001c�;{�������hUq-+��}��tGT�{hd�B�V����\\\\]��,\\u0017�Õ���=\\u0019�9~���T���$��\\\\*��pG�8#\\\"1L\\u001ed4D\\\\]\\u001d%\\u0017>�5X\\u001b�\\u0016\\u00177���q��^~ \\\\]\\\\*?q��XdJ \\\\[��{��Z;�\\u0011����)���0�w�(�������(D�@٠\\\\]� G�PCOn\\u0001}\\u0005�W�o��QU��\\u0001#��4�� F�C...\",\n  \"metadata\": {\n    \"author\": \"\",\n    \"published_date\": \"\",\n    \"word_count\": 1210,\n    \"language\": \"unknown\",\n    \"domain\": \"stacks.cdc.gov\",\n    \"content_type\": \"web_page\",\n    \"canonical_url\": \"https://stacks.cdc.gov/view/cdc/230588/cdc_230588_DS1.pdf\",\n    \"description\": \"\",\n    \"keywords\": []\n  },\n  \"extracted_data\": {\n    \"headings\": [],\n    \"paragraphs\": [],\n    \"key_points\": [],\n    \"quotes\": [],\n    \"links\": [],\n    \"images\": [],\n    \"tables\": []\n  },\n  \"quality_metrics\": {\n    \"readability_score\": 0,\n    \"content_density\": 0.018774389699052606,\n    \"authority_indicators\": [\n      \"INSTITUTIONAL_DOMAIN\"\n    ],\n    \"credibility_score\": 0.89\n  },\n  \"scrape_timestamp\": \"2025-09-30T19:07:27.873Z\",\n  \"scrape_duration\": 2185\n}"},"timestamp":"2025-10-01 00:37:27"}
