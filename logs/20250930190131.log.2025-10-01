      \"Agricultureand horticulture\",\n            \"Agrivoltaic\\nGreenhouse\\nPolytunnel\\nRow cover\\nSolar-powered pump\",\n            \"Building\",\n            \"Building-integrated photovoltaics\\nPassive solar building design\\nUrban heat island\",\n            \"Lighting\",\n            \"Daylighting\\nHybrid solar lighting\\nLight tube\\nSolar lamp\\nSolar Tuki\",\n            \"Process heat\",\n            \"Salt evaporation pond\\nSolar furnace\\nSolar pond\",\n            \"Cooking\",\n            \"Solar cooker\",\n            \"Disinfection\",\n            \"Soil solarization\\nSolar water disinfection\",\n            \"Desalination\",\n            \"Desalination\\nSolar still\",\n            \"Water heating\",\n            \"Solar combisystem\\nSolar controller\\nSolar water heating\"\n          ],\n          [\n            \"Building\",\n            \"Building-integrated photovoltaics\\nPassive solar building design\\nUrban heat island\"\n          ],\n          [\n            \"Lighting\",\n            \"Daylighting\\nHybrid solar lighting\\nLight tube\\nSolar lamp\\nSolar Tuki\"\n          ],\n          [\n            \"Process heat\",\n            \"Salt evaporation pond\\nSolar furnace\\nSolar pond\"\n          ],\n          [\n            \"Cooking\",\n            \"Solar cooker\"\n          ],\n          [\n            \"Disinfection\",\n            \"Soil solarization\\nSolar water disinfection\"\n          ],\n          [\n            \"Desalination\",\n            \"Desalination\\nSolar still\"\n          ],\n          [\n            \"Water heating\",\n            \"Solar combisystem\\nSolar controller\\nSolar water heating\"\n          ],\n          [\n            \"See also\",\n            \"Photovoltaics\\nSolar power by country\"\n          ]\n        ]\n      }\n    ]\n  },\n  \"quality_metrics\": {\n    \"readability_score\": 0.40113607606989715,\n    \"content_density\": 0.06946860118138021,\n    \"authority_indicators\": [\n     