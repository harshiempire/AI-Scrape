\\\\*w7� ��+ ���\\\\[%��L%1bz(� ��'h�Uʲ��0t+-�К��9,�!L��\\u0013���\\\\[tS^\\u001d�!��\\u0003�i��2y oQ�U̶<\\u0015eP��h���\\u0002���U�\\u0019i��j��|�34ƅDb���t쪛�\\u0016ޗ\\u0018n\\u0013�\\u000ejKX^K��l��%\\u0013>?U�ϙd...\",\n  \"metadata\": {\n    \"author\": \"\",\n    \"published_date\": \"\",\n    \"word_count\": 953,\n    \"language\": \"unknown\",\n    \"domain\": \"arxiv.org\",\n    \"content_type\": \"research_paper\",\n    \"canonical_url\": \"https://arxiv.org/vc/arxiv/papers/1112/1112.3266v1.pdf\",\n    \"description\": \"\",\n    \"keywords\": []\n  },\n  \"extracted_data\": {\n    \"headings\": [],\n    \"paragraphs\": [],\n    \"key_points\": [],\n    \"quotes\": [],\n    \"links\": [],\n    \"images\": [],\n    \"tables\": []\n  },\n  \"quality_metrics\": {\n    \"readability_score\": 0,\n    \"content_density\": 0.005938442837351554,\n    \"authority_indicators\": [\n      \"INSTITUTIONAL_DOMAIN\"\n    ],\n    \"credibility_score\": 0.9500000000000001\n  },\n  \"scrape_timestamp\": \"2025-09-30T18:53:35.687Z\",\n  \"scrape_duration\": 6109\n}"},"timestamp":"2025-10-01 00:23:35"}
