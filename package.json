{
  "name": "deep-research-agent",
  "version": "1.0.0",
  "description": "Industry-standard AI-powered research agent with comprehensive analysis, citation management, and quality validation",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "npx nodemon ",
    "start": "npx tsx src/index.ts",
    "server": "npx tsx server.ts",
    "server:dev": "npx nodemon server.ts",
    "research:example": "npx tsx examples/deep_research_example.ts",
    "production:demo": "npx tsx production_demo.ts",
    "production:demo:full": "npx tsx production_demo.ts --full",
    "working:demo": "npx tsx working_demo.ts",
    "working:demo:run": "npx tsx working_demo.ts --run",
    "local:demo": "npx tsx local_demo.ts",
    "demo": "npx tsx local_demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/",
    "test:integration": "vitest run tests/ --reporter=verbose",
    "test:performance": "vitest run tests/ --reporter=verbose --config.testTimeout=60000",
    "format": "prettier --write .",
    "lint-staged": "lint-staged",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio -p 4444",
    "typecheck": "npx tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "lint-staged": {
    "**/*.{ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^2.7.0",
    "@iarna/toml": "^2.2.5",
    "@types/ws": "^8.18.1",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "js-tiktoken": "^1.0.21",
    "jsdom": "^24.0.0",
    "mozilla-readability": "^0.1.3",
    "node-html-parser": "^6.1.0",
    "openai": "^5.19.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "serpapi": "^2.0.0",
    "turndown": "^7.2.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@prisma/client": "^6.3.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/iarna__toml": "^2.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^6.4.17",
    "@types/reflect-metadata": "^0.0.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/turndown": "^5.0.5",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prisma": "^6.3.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  }
}
