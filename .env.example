# Deep Research Agent Environment Configuration

# === REQUIRED ===
# OpenAI API Key (required for LLM synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# === OPTIONAL SEARCH APIS ===
# SerpAPI (recommended for production)
# Sign up at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Bing Search API
# Sign up at: https://azure.microsoft.com/services/cognitive-services/bing-web-search-api/
BING_SEARCH_KEY=your_bing_search_key_here

# Google Custom Search API
# Set up at: https://developers.google.com/custom-search/v1/introduction
GOOGLE_SEARCH_KEY=your_google_search_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here

# === PERFORMANCE CONFIGURATION ===
# Maximum concurrent operations
MAX_CONCURRENT_SEARCHES=5
MAX_CONCURRENT_SCRAPES=3

# Cache settings
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Rate limiting
REQUESTS_PER_SECOND=10
BURST_LIMIT=20

# Memory management
MAX_MEMORY_MB=512

# === RESEARCH CONFIGURATION ===
# Quality thresholds
MIN_SOURCE_AUTHORITY=6
CONFIDENCE_THRESHOLD=0.75
MIN_CROSS_VALIDATION=2

# Content extraction
USE_BROWSER_FOR_JS=false
RESPECT_ROBOTS_TXT=true
SCRAPING_DELAY_MS=2000

# Output preferences
DEFAULT_CITATION_STYLE=apa
INCLUDE_PERFORMANCE_METRICS=true
SAVE_INTERMEDIATE_RESULTS=false

# === LOGGING ===
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIRECTORY=./logs

# === DEVELOPMENT ===
# Set to true for additional debugging output
DEBUG_MODE=false
VERBOSE_LOGGING=false